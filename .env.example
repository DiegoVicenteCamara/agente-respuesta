# LiveKit Cloud (https://cloud.livekit.io) — proyecto -> Settings -> Keys
LIVEKIT_URL=wss://TU_SUBDOMINIO.livekit.cloud
LIVEKIT_API_KEY=TU_API_KEY
LIVEKIT_API_SECRET=TU_API_SECRET

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-TU_API_KEY
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=coral
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Tavily (https://app.tavily.com) — opcional; si se deja vacío se usa DuckDuckGo
TAVILY_API_KEY=

# Redis local (apt install redis-server) o Redis Cloud
REDIS_URL=redis://localhost:6379/0
EVENT_CHANNEL=agent_updates

# Nombre del agente (debe coincidir con la clave del CLI `lk agent dev`)
AGENT_NAME=agente-respuesta

# Puerto del backend web
HTTP_PORT=7860

# TypeSafe (Jev - Sistema 1) https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Ruteo dual de modelos (triaje Jev -> enrutamiento económico/avanzado)
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_ADVANCED_MODEL=gpt-4o

# Umbrales de la política de ruteo (defaults recomendados)
ROUTING_RISK_FAST=0.5        # riesgo < umbral y tier=low -> modelo económico
ROUTING_RISK_CRITICAL=1.5    # riesgo >= umbral -> Propose-Commit (confirmación)
ROUTING_INJECTION_THRESHOLD=0.85
ROUTING_CONFIDENCE_MIN=0.6   # confianza baja -> escalado conservador al orquestador
ROUTING_TIMEOUT_MS=600       # timeout duro de la llamada a Jev

# Seguimiento de coste (tokens -> €) por tarea; false deja el flujo intacto
COST_TRACKING_ENABLED=true
COST_EUR_PER_USD=1.0         # factor de conversión USD -> EUR
PRICING_GPT_4O_MINI_PER_1M_IN=0.15
PRICING_GPT_4O_MINI_PER_1M_OUT=0.60
PRICING_GPT_4O_PER_1M_IN=2.50
PRICING_GPT_4O_PER_1M_OUT=10.00

# Memoria persistente de conversaciones por usuario (issue #8)
MEMORY_ENABLED=true          # false deja el flujo actual intacto
MEMORY_TTL_DAYS=30           # TTL de la clave user:{user_id}:memory
MEMORY_MAX_CHARS=2000        # corte del resumen determinista de respaldo

# Earcon (tono previo) antes de cada interrupción proactiva por voz
EARCON_ENABLED=false         # true reproduce un tono breve antes de info/urgent
EARCON_PATH=                 # ruta opcional a un .wav; vacío usa el tono sintetizado

# Telefonía SIP/PSTN (LiveKit Telephony): entrada real + rellamadas salientes
SIP_ENABLED=false            # true cuando el trunk SIP está dado de alta
SIP_TRUNK_ID=                # ID del trunk outbound SIP de LiveKit (tr_....)
SIP_NUMBER=                  # DID del agente (E.164, ej. +34910000000); alias AGENT_NUMBER
# AGENT_NUMBER=              # alias aceptado de SIP_NUMBER
