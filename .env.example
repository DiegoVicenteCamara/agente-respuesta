# LiveKit Cloud (https://cloud.livekit.io) — proyecto -> Settings -> Keys
LIVEKIT_URL=wss://TU_SUBDOMINIO.livekit.cloud
LIVEKIT_API_KEY=TU_API_KEY
LIVEKIT_API_SECRET=TU_API_SECRET

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-TU_API_KEY
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=coral
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Tavily (https://app.tavily.com) — opcional; si se deja vacío se usa DuckDuckGo
TAVILY_API_KEY=

# Redis local (apt install redis-server) o Redis Cloud
REDIS_URL=redis://localhost:6379/0
EVENT_CHANNEL=agent_updates

# Nombre del agente (debe coincidir con la clave del CLI `lk agent dev`)
AGENT_NAME=agente-respuesta

# Puerto del backend web
HTTP_PORT=7860