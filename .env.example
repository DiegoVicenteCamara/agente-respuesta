# LiveKit Cloud (https://cloud.livekit.io) — proyecto -> Settings -> Keys
LIVEKIT_URL=wss://TU_SUBDOMINIO.livekit.cloud
LIVEKIT_API_KEY=TU_API_KEY
LIVEKIT_API_SECRET=TU_API_SECRET

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-TU_API_KEY
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=coral
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Tavily (https://app.tavily.com) — opcional; si se deja vacío se usa DuckDuckGo
TAVILY_API_KEY=

# Redis local (apt install redis-server) o Redis Cloud
REDIS_URL=redis://localhost:6379/0
EVENT_CHANNEL=agent_updates

# Nombre del agente (debe coincidir con la clave del CLI `lk agent dev`)
AGENT_NAME=agente-respuesta

# Puerto del backend web
HTTP_PORT=7860

# TypeSafe (Jev - Sistema 1) https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Ruteo dual de modelos (triaje Jev -> enrutamiento económico/avanzado)
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_ADVANCED_MODEL=gpt-4o

# Umbrales de la política de ruteo (defaults recomendados)
ROUTING_RISK_FAST=0.5        # riesgo < umbral y tier=low -> modelo económico
ROUTING_RISK_CRITICAL=1.5    # riesgo >= umbral -> Propose-Commit (confirmación)
ROUTING_INJECTION_THRESHOLD=0.85
ROUTING_CONFIDENCE_MIN=0.6   # confianza baja -> escalado conservador al orquestador
ROUTING_TIMEOUT_MS=600       # timeout duro de la llamada a Jev